<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">HyperPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'hyperpay'" name="hyperpay_credentials">
                    <field name="hyperpay_merchant_id" required="code == 'hyperpay' and state != 'disabled'"/>
                    <field name="hyperpay_mada_entity_id"/>
                    <field name="hyperpay_authorization" password="True"
                           required="code == 'hyperpay' and state != 'disabled'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
