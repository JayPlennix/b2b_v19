<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_method_apple_pay" model="payment.method">
        <field name="name">Apple Pay</field>
        <field name="code">Applepay</field>
        <field name="sequence">1</field>
        <field name="image" type="base64" file="payment_applepay/static/src/img/applepay_icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
        <field name="support_manual_capture">partial</field>
    </record>

    <record id="payment_acquirer_applepay" model="payment.provider">
        <field name="name">Apple Pay</field>
        <field name="code">applepay</field>
        <field name="image_128" type="base64" file="payment_applepay/static/src/img/applepay_icon.png"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="module_id" ref="base.module_payment_applepay"/>
        <field name="redirect_form_view_id" ref="payment_hyperpay.redirect_form"/>
        <!-- Pre-authorize at checkout, capture once JDE has invoiced the order. -->
        <field name="capture_manually" eval="True"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_method_apple_pay')])]"/>
    </record>
</odoo>
