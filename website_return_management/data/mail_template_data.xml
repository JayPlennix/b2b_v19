<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_template_return_order_notify" model="mail.template">
            <field name="name">Return Order Confirmation</field>
            <field name="model_id" ref="model_sale_return"/>
            <field name="subject">Return Order Confirmation - {{object.name}}</field>
            <field name="email_to">{{ (object.sale_order.user_id and object.sale_order.user_id.email_formatted) }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear Stakeholder,</p>
                    <p>
                        Please note that <t t-out="object.partner_id.name"/> requested a return order
                        <b><t t-out="object.name"/></b>
                        for the following item:
                        <b><t t-out="object.product_id.display_name"/></b>
                        on <b><t t-out="object.create_date.strftime('%Y-%m-%d %H:%M')"/></b>.
                    </p>
                    <p>
                        <b>Reason for return:</b>
                       <t t-if="object.reason_id" t-out="object.reason_id.name"/>
                    </p>
                    <p>
                        You can track and validate the return order on the portal:
                        <a t-att-href="object.get_portal_url1()"><t t-out="object.get_portal_url1()"></t></a>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>