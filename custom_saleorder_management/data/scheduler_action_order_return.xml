<odoo>
    <data noupdate="1">
        <record id="ir_cron_call_return_order_api" model="ir.cron">
            <field name="name">Call Return Order JDE Every 10 Minutes</field>
            <field name="model_id" ref="model_stock_picking"/>
            <field name="state">code</field>
            <field name="code">model._fetch_return_order_grv_from_jde()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
