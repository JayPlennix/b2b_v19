<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Kept from 17.0 so that existing transactions keep their payment method. -->
    <record id="payment_method_hyperpay" model="payment.method">
        <field name="name">Hyperpay</field>
        <field name="code">hyperpay</field>
        <field name="sequence">10</field>
        <field name="active">False</field>
        <field name="image" type="base64" file="payment_hyperpay/static/src/img/hyperpay-logo.jpg"/>
    </record>

    <record id="payment_acquirer_hyperpay" model="payment.provider">
        <field name="name">HyperPay</field>
        <field name="code">hyperpay</field>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="image_128" type="base64" file="payment_hyperpay/static/src/img/hyperpay-logo.jpg"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="module_id" ref="base.module_payment_hyperpay"/>
        <!-- Pre-authorize at checkout, capture once JDE has invoiced the order. -->
        <field name="capture_manually" eval="True"/>
        <field name="payment_method_ids" eval="[Command.set([
            ref('payment.payment_method_card'),
            ref('payment.payment_method_visa'),
            ref('payment.payment_method_mastercard'),
            ref('payment.payment_method_mada'),
        ])]"/>
    </record>
</odoo>
