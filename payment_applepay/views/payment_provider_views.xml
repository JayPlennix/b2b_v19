<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="acquirer_form_applepay" model="ir.ui.view">
        <field name="name">Apple Pay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'applepay'" name="applepay_credentials">
                    <field name="applepay_entity_id" required="code == 'applepay' and state != 'disabled'"/>
                    <field name="applepay_authorization_bearer" password="True"
                           required="code == 'applepay' and state != 'disabled'"/>
                    <field name="applepay_display_name"/>
                    <field name="applepay_merchant_identifier"/>
                    <field name="applepay_supported_networks"/>
                    <field name="applepay_supported_countries"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
