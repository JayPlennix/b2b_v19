<odoo>
    <record id="view_picking_form_inherit_tracking_integration" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.tracking.integration</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='scheduled_date']" position="before">
                 <field name="jde_state" />
            </xpath>
            <field name="location_id" position="after">
                <field name="grv_order_type" />
            </field>
            <!-- Locate the existing "Extra" page and add fields inside -->
            <xpath expr="//page[@name='extra']" position="inside">
                <group string="Driver Tracking Information">
                     <group>
                         <group>
                    <field name="driver"/>
                    <field name="vehicle"/>
                    <field name="order_type"/>
                    <field name="asset_latitude"/>
                             </group>
                         <group>
                    <field name="asset_longitude"/>
                         <field name="customer_latitude"/>
                    <field name="customer_longitude"/>
                             </group>
                         </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_integration" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.tracking.integration</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="jde_state" optional="show" widget="badge"/>
            </xpath>
        </field>
    </record>
</odoo>


