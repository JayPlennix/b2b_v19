<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sale_return_rule_portal" model="ir.rule">
        <field name="name">sale.return: portal: my return orders</field>
        <field name="model_id" ref="model_sale_return"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
