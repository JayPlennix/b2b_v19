<odoo>
    <data>
        <record id="product_category_form_view_inherit_tecnibo_purchase" model="ir.ui.view">
            <field name="name">product.category.form.inherit.tecnibo_purchase</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='first']" position="after">
                    <group string="company">
                        <field name="company_id"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="product_category_tree_view_inherit" model="ir.ui.view">
            <field name="name">product.category.tree.inherit</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_list_view"/>
            <field name="arch" type="xml">
                <field name="display_name" position="after">
                    <field name="company_id"/>
                </field>
            </field>
        </record>
    </data>
</odoo>