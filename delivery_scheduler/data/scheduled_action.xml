<odoo>
    <data noupdate="1">
        <record id="ir_cron_call_bulk_quantity_api" model="ir.cron">
            <field name="name">Call Update Delivery Scheduler API Every 2 Hours</field>
            <field name="model_id" ref="delivery_scheduler.model_delivery_scheduler"/>
            <field name="state">code</field>
            <field name="code">model.update_delivery_scheduler_api()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
