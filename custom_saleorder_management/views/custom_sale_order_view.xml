<odoo>
    <record id="view_order_form_inherit_append_stages" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.append.stages</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,sent,sale,jde_confirmed,credit_control,order_at_WH,order_confirmed,ready_to_ship,invoice_printed"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_jde_confirm" string="Create JDE Order"
                            type="object" class="oe_highlight"
                            invisible="state not in ['sale']"/>
            </xpath>
        </field>
    </record>
</odoo>