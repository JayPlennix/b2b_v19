<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_track_btn" inherit_id="sale.sale_order_portal_template" name="Sale Order Track Order">
        <xpath expr="//h2[@t-field='sale_order.amount_total']" position="attributes">
            <attribute name="t-field">sale_order.jde_amount_total</attribute>
            <attribute name="data-id">total_amount</attribute>
        </xpath>
        <xpath expr="//div[@id='print_invoice_sidebar_button']" position="after">
            <div class="flex-grow-1 mt-2">
                <a class="btn btn-light o_print_btn d-block tracking_sale_order" id="tracking_sale_order"
                   href="#" title="Track Order" t-att-data-sale-order-id="sale_order.id">
                    <img src="/custom_saleorder_management/static/src/img/delivery_truck.png" class="tracking_order"
                         alt="Track Order"/>
                    Track Order
                </a>
            </div>
        </xpath>
    </template>
</odoo>
