<odoo>
    <data noupdate="1">
        <record id="ir_cron_call_bulk_quantity_api" model="ir.cron">
            <field name="name">Call Update Quantity Bulk API Every 20 Minutes</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="state">code</field>
            <field name="code">model.update_quantity_bulk_api()</field>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
