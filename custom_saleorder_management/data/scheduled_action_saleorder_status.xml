<odoo>
    <data noupdate="1">
        <record id="ir_cron_call_saleorder_api" model="ir.cron">
            <field name="name">Call Update SaleOrder Status Every 10 Minutes</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.update_saleorder_status()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
