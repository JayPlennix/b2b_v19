<odoo>
    <data>
        <record id="product_template_transmed_b2b_inherit_form" model="ir.ui.view">
            <field name="name">product.template.transmed.b2b.inherit.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_information']" position="after">

                    <page string="Transmed-b2b" name="transmed-b2b">
                        <group>
                            <group>
                                <field name="storage"/>
                                <field name="temperature"/>
                                <field name="product_family"/>
                                <field name="product_family_name"/>
                                <field name="short_item_no"/>
                                <field name="item_type"/>
                                <field name="item_type_name"/>
                                <field name="jde_stock_location"/>

                                <field name="product_selling_type" invisible="item_type != 'ARP'"/>

                            </group>
                            <group>
                                <field name="brand"/>
                                <field name="brand_id"/>
                                <field name="brand_name"/>
                                <field name="brand_type"/>
                                <field name="brand_type_name"/>
                                <field name="supplier_code"/>
                                <field name="supplier_name"/>
                                <field name="timestamp_jde"/>
                                <field name="check_availability"/>
                                <field name="create_via_api" invisible="1"/>
                                <field name="jde_product_id"/>
                            </group>

                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_form_inherit_jde_name" model="ir.ui.view">
            <field name="name">product.template.form.jde.product.name</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='options']" position="after">
                    <group>
                        <field name="jde_product_name" string="JDE Product Name"/>
                    </group>
                </xpath>
                 <xpath expr="//field[@name='name']" position="attributes">
                    <!-- Make the product name read-only after creation -->
                    <attribute name="readonly">id</attribute>
                </xpath>
            </field>
        </record>


    </data>
</odoo>