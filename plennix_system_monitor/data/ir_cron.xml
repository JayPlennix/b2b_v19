<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="system_monitor_log_cron" forcecreate="True" model="ir.cron">
            <field name="name">System Monitor: Send Daily Errors Log</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_system_monitor_log"/>
            <field name="state">code</field>
            <field name="code">model.send_daily_log()</field>
        </record>

    </data>
</odoo>
