<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Create Filter Record -->
        <record id="best_selling_products_filter" model="ir.filters">
            <field name="name">Best Selling Products</field>
            <field name="model_id">product.product</field>
            <field name="user_ids" eval="False"/>
            <field name="domain">[('best_selling_product', '=', True)]</field>
            <field name="sort">["sequence asc"]</field>
        </record>

        <!-- Create Best Selling Product Filter Records -->
        <record id="dynamic_filter_best_selling_product" model="website.snippet.filter">
            <field name="filter_id" ref="custom_website.best_selling_products_filter"/>
            <field name="field_names">name,display_name,description_sale,image_512,uom_id</field>
            <field name="limit" eval="16"/>
            <field name="name">Best Selling Products</field>
        </record>

    </data>
</odoo>