<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dynamic_filter_template_product_product_mini_product_card" name="Mini Products">
        <t t-foreach="records" t-as="data"
           data-number-of-elements="6"
           data-number-of-elements-sm="1"
           data-thumb="/website_sale/static/src/img/snippets_options/product_horizontal_card.svg">
            <t t-set="record" t-value="data['_record']"/>
            <t t-set="b2b_display" t-value="record.product_tmpl_id._b2b_price_display()"/>
            <div class="o_carousel_product_card card w-100 p-3 o_b2b_mini_product"
                 t-att-data-add2cart-rerender="data.get('_add2cart_rerender')">
                <div t-if="is_sample" class="h5 o_ribbon_right bg-primary text-uppercase">Sample</div>
                <input type="hidden" name="product-id" t-att-data-product-id="record.id"/>
                <a class="stretched-link o_dynamic_product_hovered" t-att-href="record.website_url">
                    <img class="img img-fluid mx-auto d-block o_img_product_square" loading="lazy"
                         style="max-width: 75%;" t-att-src="data['image_512']" t-att-alt="record.display_name"/>
                </a>
                <div class="card-title h6 mt-2 o_b2b_mini_product_name" t-field="record.name"/>
                <div class="mb-1" t-if="is_view_active('website_sale.product_comment')">
                    <t t-call="portal_rating.rating_widget_stars_static">
                        <t t-set="rating_avg" t-value="record.rating_avg"/>
                        <t t-set="rating_count" t-value="record.rating_count"/>
                    </t>
                </div>
                <div class="my-2 text-danger" t-if="not data.get('prevent_zero_price_sale') and not is_sample">
                    <span class="fw-bold" t-out="data['price'] * b2b_display[0]"
                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    <span t-if="b2b_display[1]">/ <t t-out="b2b_display[1]"/></span>
                </div>
            </div>
        </t>
    </template>
</odoo>
